classDiagram
    Livre "1" -- "1" Exemplaire : contient
    Livre "1" --> "0..*" Auteur : écrit par
    Livre "1" -- "0..*" Categorie : appartient à
    Utilisateur "1" -- "0..*" Exemplaire : emprunte
    class Livre {
        - titre : string
        - isbn : string
        + emprunter() : bool
    }
    class Exemplaire {
        - id : int
        - etat : string
    }
    class Auteur {
        - nom : string
    }
    class Categorie {
        - nom : string
    }
    class Utilisateur {
        - nom : string
        + s'inscrire() : void
    }
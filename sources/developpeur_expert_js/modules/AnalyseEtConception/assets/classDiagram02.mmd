classDiagram
    Projet "1" --> "0..*" Tache : contient
    Utilisateur "1" --> "0..*" Tache : est assigné à
    class Projet {
        - nom : string
        - dateDebut : Date
        - dateFin : Date
    }
    class Tache {
        - titre : string
        - description : string
        - etat : string
        + changerEtat(nouvelEtat : string) : void
    }
    class Utilisateur {
        - nom : string
        - email : string
        + seConnecter() : void
    }